# Managed by chezmoi (workspace-dotfiles, dot_config/seek/client.yml.tmpl). See docs/seek.md.
server:
  url: {{ .seek.url | quote }}
  # The client token is read from OpenBao when a command calls the server. The Wyrwood socket adds the binding's
  # login and namespace, so seek sends neither (auth none, namespace ""). Settings in the token's own vault block
  # are not overridden by an exported BAO_ADDR, BAO_TOKEN or BAO_NAMESPACE.
  token:
    vault:
      address: unix:///run/wyrwood/vault.sock
      namespace: ""
      auth:
        mode: none
      mount: {{ .seek.token.mount | quote }}
      path: {{ .seek.token.path | quote }}
      key: {{ .seek.token.key | quote }}
