#!/bin/bash
# dot_Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}
set -e
# On a fresh install, tapping charmbracelet/tap and wyrd-company/tools fails with "Invalid formula (golden_gate)".
# Formulas that need them tap them later in the run, but `brew bundle` still exits 1. A real failure fails twice.
brew bundle --file {{ joinPath .chezmoi.sourceDir "dot_Brewfile" | quote }} ||
  brew bundle --file {{ joinPath .chezmoi.sourceDir "dot_Brewfile" | quote }}
