#!/bin/sh
# Global core.sshCommand. Reads use the forwarded agent without selecting an operator.
# Publishing through receive-pack still requires one; the shim also checks pushes over HTTPS
# and local transports. No hooks are needed, so repository hooks keep working.
publishing=false
for arg do
  case "$arg" in
    git-receive-pack|git-receive-pack\ *|*/git-receive-pack\ *|git\ receive-pack\ *) publishing=true ;;
  esac
done
if [ "$publishing" = false ]; then
  exec ssh "$@"
fi
if [ -n "$GIT_OPERATOR" ]; then
  exec ssh "$@"   # unreachable in practice: the shim overrides core.sshCommand with -c
fi
ops=$(ls "$HOME/.config/git/operators" 2>/dev/null | tr '\n' ' ')
if [ -n "$T3CODE_THREAD_ID" ]; then
  echo "git: SSH push requires an operator; none is registered for this thread ($T3CODE_THREAD_ID)." >&2
  echo "     Ask the user which operator they are, then run: git operator set <handle>" >&2
else
  echo "git: SSH push requires an operator. Run: git <handle> push ..." >&2
fi
echo "     known operators: ${ops:-none configured}" >&2
exit 1
