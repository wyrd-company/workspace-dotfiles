#!/bin/sh
# git-as <handle> <git args...>: run git as a named operator.
# Invoked through the per-operator symlinks `git-<handle>`, so `git boblangley push` works as a git subcommand.
# It only names the operator: the git shim (~/.local/bin/git) applies the identity from
# ~/.config/git/operators/<handle>, and inside a T3 thread checks it against the thread's registration
# (`git operator`). Agents in a registered thread use plain git; this is the path for human terminals.
set -e

self=$(basename "$0")
case "$self" in
  git-as) handle=$1; [ -n "$handle" ] || { echo "usage: git-as <handle> <git args>" >&2; exit 2; }; shift ;;
  git-*)  handle=${self#git-} ;;
  *)      echo "git-as: unexpected invocation name '$self'" >&2; exit 2 ;;
esac

[ -r "$HOME/.config/git/operators/$handle" ] || { echo "git-as: unknown operator '$handle'" >&2; exit 2; }

GIT_OPERATOR=$handle; export GIT_OPERATOR
exec "$HOME/.local/bin/git" "$@"
