#!/usr/bin/env bash
# AWS CLI credential_process: prints an S3 key stored in OpenBao, read through the Wyrwood socket
# (BAO_ADDR). Managed by workspace-dotfiles; see docs/aws-cli.md.
#
#   credential_process = aws-bao-credentials kv/workspace/r2/buckets/<bucket>
#
# The secret is KV v2 with nonempty string fields access_key_id and secret_access_key. The key is
# read on every AWS CLI call and never written to disk, so a rotation applies to the next call.
set -euo pipefail

fail() {
  printf 'aws-bao-credentials: %s\n' "$*" >&2
  exit 1
}

case "${1:-}" in
  -h | --help)
    sed -n '2,9s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
  "") fail "usage: aws-bao-credentials <namespace-relative kv path>" ;;
esac
[[ $# -eq 1 ]] || fail "usage: aws-bao-credentials <namespace-relative kv path>"
path="$1"

command -v bao >/dev/null 2>&1 || fail "bao is required to read credentials through Wyrwood."
command -v jq >/dev/null 2>&1 || fail "jq is required."

secret=$(bao kv get -format=json "$path") \
  || fail "Cannot read $path through Wyrwood; check that the bound policy grants it (see docs/aws-cli.md)."

# One read keeps both fields at the same KV version.
jq -e '
  .data.data
  | if (.access_key_id | type == "string" and length > 0)
      and (.secret_access_key | type == "string" and length > 0)
    then {Version: 1, AccessKeyId: .access_key_id, SecretAccessKey: .secret_access_key}
    else error("missing fields") end
' 2>/dev/null <<<"$secret" \
  || fail "$path must contain nonempty access_key_id and secret_access_key strings."
